{
  "name": "gvdg-club-site-static",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:score",
    "build:score": "vite build --config vite.score.config.mjs",
    "doctor": "react-doctor --no-dead-code --no-score --blocking none",
    "qa:live-scoring": "npm run build:score && node scripts/qa/live-scoring-browser-qa.mjs",
    "qa:react": "npm run doctor",
    "qa:staging-live-scoring": "node scripts/qa/staging-live-scoring-e2e.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "react-doctor": "^0.7.1",
    "react-grab": "^0.1.48",
    "react-scan": "^0.5.7",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
